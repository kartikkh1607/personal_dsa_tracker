# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard > Project Settings > API.
#
# .env.local is gitignored. Everything here is VITE_-prefixed, which means Vite
# inlines it into the client bundle - so only ever put public values here.
# The publishable key is designed for that; the service_role key never is.

VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase's "publishable key" (what used to be called the anon key).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Google sign-in is implemented but hidden until you've set up an OAuth client
# in Google Cloud and added it as a provider in Supabase. Magic link works
# without this. Uncomment to show the Google button.
# VITE_ENABLE_GOOGLE_AUTH=true
